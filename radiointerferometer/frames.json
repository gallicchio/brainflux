    "noise": {"select": ["#fig-stream1"], "js": "__app.hold(true); __app.runSetup('noise').then(() => __app.step(120))"},
    "lag": {"select": ["#block-one"], "js": "__app.hold(true); __app.runSetup('lag').then(() => __app.step(400))"},
    "white": {"select": ["#fig-spec1", "#fig-lag1"], "js": "__app.hold(true); __app.runSetup('white').then(() => __app.step(200))"},
