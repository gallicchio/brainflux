    "independent": {"select": ["#fig-product1", "#fig-lag1"], "js": "__app.hold(true); __app.runSetup('independent').then(() => __app.step(600))"},
    "fringe": {"select": ["#fig-scene", "#fig-plane2", "#fig-fringe"], "js": "__app.hold(true); __app.runSetup('fringe').then(() => __app.step(300))"},
    "twosources": {"select": ["#fig-scene", "#fig-plane2", "#fig-fringe"], "js": "__app.hold(true); __app.runSetup('twosources').then(() => __app.step(500))"},
    "young": {"select": ["#fig-scene", "#fig-plane2", "#fig-fringe"], "js": "__app.hold(true); __app.runSetup('young').then(() => __app.step(300))"},
